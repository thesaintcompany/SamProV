# SAMpro Configuration

# API Server Port
API_PORT=3001

# Email Configuration (Optional - if using SMTP instead of sendmail)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password
# SMTP_FROM=noreply@sampro.ro

# Sendmail Configuration (Default)
# If using sendmail, the server will use the system's sendmail binary
# at /usr/sbin/sendmail
